{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "poll-route": {
                "ClusterId": "poll-cluster",
                "Match": {
                    "Path": "/api/polls/{**catch-all}"
                }
            },
            "vote-route": {
                "ClusterId": "vote-cluster",
                "Match": {
                    "Path": "/api/votes/{**catch-all}"
                }
            },
            "signalr-route": {
                "ClusterId": "realtime-cluster",
                "Match": {
                    "Path": "/hubs/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "poll-cluster": {
                "Destinations": {
                    "destination1": { "Address": "http://localhost:5001" }
                }
            },
            "vote-cluster": {
                "Destinations": {
                    "destination1": { "Address": "http://localhost:5002" }
                }
            },
            "realtime-cluster": {
                "Destinations": {
                    "destination1": { "Address": "http://localhost:5003" }
                }
            }
        }
    }
}